<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="power_usage_summary_screen"
    android:title="@string/power_usage_summary_title"
    settings:keywords="@string/keywords_battery">

    <!-- Panel 1: Material 3 Expressive Solid Monet Hero Battery Card -->
    <com.android.settings.fuelgauge.M3BatteryHeaderPreference
        android:key="m3_battery_header"
        android:selectable="false"
        settings:controller="com.android.settings.fuelgauge.M3BatteryHeaderPreferenceController" />

    <!-- Panel 2: Material 3 Thick Pill Daily Usage Chart & App Breakdown Card -->
    <com.android.settings.fuelgauge.batteryusage.M3BatteryUsageCardPreference
        android:key="m3_battery_usage_card"
        android:selectable="false"
        settings:controller="com.android.settings.fuelgauge.batteryusage.M3BatteryUsageCardController" />

    <com.android.settingslib.widget.LayoutPreference
        android:key="battery_help_message"
        android:layout="@layout/preference_battery_error"
        android:selectable="false"
        android:visible="false"
        settings:searchable="false" />

    <com.android.settingslib.widget.BannerMessagePreference
        android:key="battery_tip"
        android:title="@string/summary_placeholder"
        android:visible="false"
        settings:controller="com.android.settings.fuelgauge.batterytip.BatteryTipPreferenceController" />

    <!-- Legacy controller placeholder kept invisible to satisfy dependency in PowerUsageSummary -->
    <com.android.settings.fuelgauge.BatteryHeaderTextPreference
        android:key="battery_header_text"
        android:selectable="false"
        android:visible="false"
        settings:controller="com.android.settings.fuelgauge.BatteryHeaderTextPreferenceController" />

    <!-- Panel 3: Material 3 2x2 Bento Grid for Power Management (Manajemen Daya) -->
    <com.android.settings.fuelgauge.M3BatteryManagementPreference
        android:key="m3_battery_management_card"
        android:selectable="false"
        settings:controller="com.android.settings.fuelgauge.M3BatteryManagementPreferenceController" />

    <!-- Panel 4: Material 3 3-Capsule Selector for Charging Settings (Pengaturan Pengisian Daya) -->
    <com.android.settings.fuelgauge.M3BatteryChargingPreference
        android:key="m3_battery_charging_card"
        android:selectable="false"
        settings:controller="com.android.settings.fuelgauge.M3BatteryChargingPreferenceController" />

    <!-- Panel 5: Material 3 Grouped Card for Battery Info & Display (Info & Tampilan Baterai) -->
    <com.android.settings.fuelgauge.M3BatteryInfoDisplayPreference
        android:key="m3_battery_info_display_card"
        android:selectable="false"
        settings:controller="com.android.settings.fuelgauge.M3BatteryInfoDisplayPreferenceController" />

    <com.android.settingslib.widget.FooterPreference
        android:key="power_usage_footer"
        android:title="@string/battery_footer_summary"
        android:visible="false"
        settings:searchable="false" />
</PreferenceScreen>
