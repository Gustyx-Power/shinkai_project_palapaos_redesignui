<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="20dp"
    android:clipToPadding="false"
    android:selectable="false"
    android:clickable="false">

    <!-- 1. Top Hero Banner Card (OriginOS 6 / iQOO style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/about_iqoo_banner_card"
        android:layout_width="match_parent"
        android:layout_height="165dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/iqoo_banner_art_bg">

            <!-- Subtle Gradient Scrim Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3.5dp"
                android:background="@drawable/about_banner_scrim" />

            <!-- Centered OriginOS / Palapa OS Branding -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/about_iqoo_banner_logo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/kopdes"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/about_iqoo_banner_os_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Palapa OS"
                        android:textSize="26sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/about_iqoo_banner_os_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Trowulan Edition • Shinkai Project"
                        android:textSize="12sp"
                        android:textColor="#CCFFFFFF"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 2. Device Marketing Name Title (iQOO Z9x 5G style -> POCO F5) -->
    <TextView
        android:id="@+id/about_iqoo_marketing_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:text="POCO F5"
        android:textSize="26sp"
        android:fontFamily="@font/product_sans_bold"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:includeFontPadding="false" />

    <!-- 3. Specifications Block with Accent Bars (▎) -->
    <!-- Spec 1: Nama perangkat > -->
    <LinearLayout
        android:id="@+id/about_spec_device_name_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/iqoo_spec_accent_bar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/iqoo_spec_device_name_label"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:includeFontPadding="false" />

            <ImageView
                android:id="@+id/about_spec_device_name_edit_btn"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_mode_edit"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/edit" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right_24dp"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_spec_device_name_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="4dp"
            android:text="Gustyx POCO F5"
            android:textSize="14.5sp"
            android:fontFamily="@font/product_sans_bold"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Spec 2: Prosesor -->
    <LinearLayout
        android:id="@+id/about_spec_processor_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:layout_marginTop="4dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/iqoo_spec_accent_bar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iqoo_spec_processor_label"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_spec_processor_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="4dp"
            android:text="2.91 GHz Qualcomm® Snapdragon® 7+ Gen 2 Mobile Platform Octa-core"
            android:textSize="14.5sp"
            android:fontFamily="@font/product_sans_bold"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Spec 3 & 4: Penyimpanan telepon & RAM (Two columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:paddingBottom="10dp">

        <!-- Column 1: Penyimpanan telepon -->
        <LinearLayout
            android:id="@+id/about_spec_storage_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/iqoo_spec_accent_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/iqoo_spec_storage_label"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_spec_storage_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_marginTop="4dp"
                android:text="256 GB"
                android:textSize="14.5sp"
                android:fontFamily="@font/product_sans_bold"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Column 2: RAM -->
        <LinearLayout
            android:id="@+id/about_spec_ram_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/iqoo_spec_accent_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/iqoo_spec_ram_label"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="11dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/about_spec_ram_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 GB + 8 GB"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/product_sans_bold"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="ⓘ"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Spec 5: Kapasitas baterai -->
    <LinearLayout
        android:id="@+id/about_spec_battery_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:layout_marginTop="4dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/iqoo_spec_accent_bar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iqoo_spec_battery_label"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_spec_battery_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="4dp"
            android:text="5000 mAh"
            android:textSize="14.5sp"
            android:fontFamily="@font/product_sans_bold"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 4. Grouped Menu Card with Solid Material Monet Palette -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Info versi -->
            <LinearLayout
                android:id="@+id/about_menu_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="16dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/iqoo_menu_version_title"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/iqoo_menu_version_summary"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24dp"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="?android:attr/listDivider"
                android:alpha="0.25" />

            <!-- 2. Info status -->
            <LinearLayout
                android:id="@+id/about_menu_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="16dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/iqoo_menu_status_title"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/iqoo_menu_status_summary"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24dp"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="?android:attr/listDivider"
                android:alpha="0.25" />

            <!-- 3. Informasi hukum -->
            <LinearLayout
                android:id="@+id/about_menu_legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="16dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/iqoo_menu_legal_title"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/iqoo_menu_legal_summary"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24dp"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="?android:attr/listDivider"
                android:alpha="0.25" />

            <!-- 4. Layanan pelanggan -->
            <LinearLayout
                android:id="@+id/about_menu_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="16dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/iqoo_menu_customer_title"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/iqoo_menu_customer_summary"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24dp"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. Bottom Footer: Android Robot Icon + Android 17 -->
    <LinearLayout
        android:id="@+id/about_footer_android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="4dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/about_footer_android_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_android_17_platlogo"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/about_footer_android_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Android 17"
            android:textSize="16.5sp"
            android:fontFamily="@font/product_sans_bold"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
