<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/oneui_battery_card_bg"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Item 1: Battery status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/oneui_battery_status_title"
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/oneui_info_battery_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Not charging"
                    android:textColor="@color/oneui_battery_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Divider 1 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/oneui_battery_divider" />

            <!-- Item 2: Battery level -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/oneui_battery_level_legend"
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/oneui_info_battery_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="81%"
                    android:textColor="@color/oneui_battery_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Divider 2 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/oneui_battery_divider" />

            <!-- Item 3: Battery capacity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/oneui_battery_capacity_title"
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/oneui_info_battery_capacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="4500 mAh (typical)"
                    android:textColor="@color/oneui_battery_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Disclaimer Text Below Card -->
        <TextView
            android:id="@+id/oneui_info_disclaimer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/oneui_battery_info_disclaimer"
            android:textColor="@color/oneui_battery_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
