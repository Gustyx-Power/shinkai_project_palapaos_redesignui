<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp"
    android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/spoof_header_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/settingslib_materialColorOutlineVariant"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header: Shield Icon Box + Title & Subtitle + Active Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/spoof_header_icon_bg"
                    android:padding="11dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_security_lock_24dp"
                        app:tint="#10B981"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/spoof_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spoof_card_header_title"
                        android:textSize="17.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_card_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/spoof_card_header_subtitle"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Active Pill Badge -->
                <TextView
                    android:id="@+id/spoof_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_badge_pill_green"
                    android:text="PROTECTED"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3.5dp"
                    android:paddingBottom="3.5dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 2. Active Mode & Profile Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/spoof_info_box_bg"
                android:orientation="vertical"
                android:padding="13dp">

                <!-- Row 1: Target Certified Profile -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/home_badge_pill_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Target Profile:"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_active_profile_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Google Pixel 5 (redfin)"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Row 2: Attestation Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/home_circle_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Attestation Engine:"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_active_engine_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Play Integrity Fix (Software Mode)"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Row 3: Fingerprint Chip Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/spoof_card_chip_bg"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/spoof_active_fingerprint_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="google/redfin/redfin:14/UP1A.231105.001.B2/11260742:user/release-keys"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace"
                        android:textColor="?android:attr/textColorSecondary"
                        android:maxLines="2"
                        android:ellipsize="middle"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
