<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/spoof_header_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header: Shield Icon Box + Title & Subtitle + Active Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spoof_header_icon_bg"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_security_lock_24dp"
                        app:tint="#10B981"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/spoof_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spoof_card_header_title"
                        android:textSize="17sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_card_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/spoof_card_header_subtitle"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Active Pill Badge -->
                <TextView
                    android:id="@+id/spoof_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_badge_pill_green"
                    android:text="ACTIVE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 2. Status Chips Row (Play Integrity | Keybox | Bootloader) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- Chip 1: Play Integrity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/spoof_card_chip_bg"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INTEGRITY"
                        android:textSize="10sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_chip_integrity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="DEVICE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#10B981"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Chip 2: Keybox -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/spoof_card_chip_bg"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KEYBOX"
                        android:textSize="10sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_chip_keybox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="ACTIVE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#06B6D4"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Chip 3: Bootloader -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/spoof_card_chip_bg"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BOOTLOADER"
                        android:textSize="10sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_chip_bootloader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="LOCKED"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#10B981"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Active Profile & Fingerprint Info Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/spoof_info_box_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Profile:"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/spoof_active_profile_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Google Pixel 8 Pro (husky)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/spoof_active_fingerprint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="google/husky/husky:14/AP2A.240805.005/12025142:user/release-keys"
                    android:textSize="10.5sp"
                    android:fontFamily="monospace"
                    android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="2"
                    android:ellipsize="middle"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
