<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_homepage_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content_scrollable_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.android.settings.widget.HomepageAppBarScrollingViewBehavior">

        <LinearLayout
            android:id="@+id/homepage_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/suggestion_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?android:attr/listPreferredItemPaddingStart"
                android:layout_marginEnd="?android:attr/listPreferredItemPaddingEnd" />

            <FrameLayout
                android:id="@+id/contextual_cards_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/contextual_card_side_margin"
                android:layout_marginEnd="@dimen/contextual_card_side_margin"/>

            <FrameLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:touchscreenBlocksFocus="false"
        android:keyboardNavigationCluster="false">
        <LinearLayout
            android:id="@+id/app_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?android:attr/colorBackground">

            <!-- 1. Header Title: Pengaturan + User Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/home_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_label"
                    android:textSize="30sp"
                    android:fontFamily="@font/product_sans_bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:includeFontPadding="false" />

                <!-- Shinkai Header Logo -->
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/home_circle_green"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_shinkai_logo"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2. At a Glance Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Left Shinkai Logo Circle -->
                    <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/home_circle_green"
                    android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_shinkai_logo"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <!-- Center Texts: Hai User! & Animated Flipper Text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_glance_greeting"
                            android:textSize="15sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:includeFontPadding="false" />

                        <!-- Animated Ticker Text -->
                        <ViewFlipper
                            android:id="@+id/home_glance_flipper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:flipInterval="3000"
                            android:autoStart="true"
                            android:inAnimation="@anim/shinkai_slide_in_bottom"
                            android:outAnimation="@anim/shinkai_slide_out_top">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_glance_shinkai_top"
                                android:textSize="12sp"
                                android:fontFamily="@font/product_sans_bold"
                                android:textColor="?android:attr/textColorSecondary"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_glance_karya_bangsa"
                                android:textSize="12sp"
                                android:fontFamily="@font/product_sans_bold"
                                android:textColor="@color/settingslib_materialColorPrimary"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_glance_palapa_edition"
                                android:textSize="12sp"
                                android:fontFamily="@font/product_sans_bold"
                                android:textColor="?android:attr/textColorSecondary"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_glance_smooth_perf"
                                android:textSize="12sp"
                                android:fontFamily="@font/product_sans_bold"
                                android:textColor="?android:attr/textColorSecondary"
                                android:includeFontPadding="false" />

                        </ViewFlipper>
                    </LinearLayout>

                    <!-- Right Hashtag Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/palapa_hashtag_badge_bg"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="#ShinkaiProjectOnTop!"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                        android:includeFontPadding="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hidden stub for search_action_bar to keep SettingsHomepageActivity safe -->
            <View
                android:id="@+id/search_action_bar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
