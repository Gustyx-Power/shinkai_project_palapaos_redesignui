<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Card 1: STATUS & TINGKAT BATERAI -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_battery_card_surface"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/m3_sub_status_icon_box"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_info_status_level_header"
                    android:textColor="#8A9A90"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/m3_sub_battery_level_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="56% • Mengisi daya"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <!-- Right Icon: Bright Green Squircle -->
            <FrameLayout
                android:id="@+id/m3_sub_status_icon_box"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/m3_battery_hero_icon_bg">

                <ImageView
                    android:id="@+id/m3_sub_status_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_battery_charging_full"
                    app:tint="#044426"
                    android:contentDescription="@null" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Card 2: Kesehatan Baterai -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_battery_card_surface"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/m3_sub_health_badge"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_battery_health_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/m3_sub_health_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kapasitas terukur 4850 mAh dari 5000 mAh (tipikal)"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:id="@+id/m3_sub_health_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/m3_battery_badge_green_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="70%\n(Baik)"
                android:gravity="center"
                android:textColor="#7EE2A7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />
        </RelativeLayout>

        <!-- Card 3: Siklus Pengisian -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_battery_card_surface"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/m3_sub_cycle_value"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_battery_cycle_count_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/m3_info_cycles_desc"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:id="@+id/m3_sub_cycle_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="1354 kali"
                android:textColor="#FFD56B"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold" />
        </RelativeLayout>

        <!-- 3-Column Bento Grid: Kapasitas, Suhu Baterai, Voltase Baterai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <!-- Col 1: Kapasitas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_card_surface"
                android:padding="16dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_info_capacity_col_title"
                    android:textColor="#A3C6B1"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/m3_sub_col_capacity_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="5000 mAh"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/m3_info_capacity_col_sub"
                    android:textColor="#A3C6B1"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Col 2: Suhu Baterai -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_card_surface"
                android:padding="16dp"
                android:layout_marginHorizontal="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_info_temp_col_title"
                    android:textColor="#A3C6B1"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/m3_sub_col_temp_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="38,9 °C"
                    android:textColor="#7EE2A7"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/m3_info_temp_col_sub"
                    android:textColor="#A3C6B1"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Col 3: Voltase Baterai -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_card_surface"
                android:padding="16dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_info_volt_col_title"
                    android:textColor="#A3C6B1"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/m3_sub_col_volt_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="3,90 V"
                    android:textColor="#7EE2A7"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/m3_info_volt_col_sub"
                    android:textColor="#A3C6B1"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>

        <!-- Footer: IEC 61960 Disclaimer Note -->
        <TextView
            android:id="@+id/m3_sub_disclaimer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="@string/m3_battery_disclaimer"
            android:textColor="#8A9A90"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

</ScrollView>
