<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- 1. Hero Memory & RAM Expansion Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ram_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Row: Usage Pill Badge (Left) + Tersedia Label (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left: % Digunakan Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/storage_pill_badge_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/ram_dot_green"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/ram_badge_used_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="48% DIGUNAKAN"
                        android:textSize="11sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Right: Active Status Subtitle -->
                <TextView
                    android:id="@+id/ram_hero_status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+4 GB (Default)"
                    android:textSize="12sp"
                    android:textColor="#34D399"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Middle Row: Big Used Metric (Left) + Chip Icon (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/ram_big_used_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.2"
                            android:textSize="40sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/ram_big_used_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp"
                            android:text="GB"
                            android:textSize="18sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ram_stat_total_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="dari 12 GB Total RAM"
                        android:textSize="12.5sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/home_icon_box_green"
                    android:padding="11dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_ram_expansion"
                        app:tint="#34D399"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <!-- RAM Usage Horizontal Multi-Segment Progress Bar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:id="@+id/ram_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <!-- Segment 1: RAM Terpakai (Emerald) -->
                    <View
                        android:id="@+id/ram_bar_used"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="42"
                        android:background="#10B981" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/ram_bar_div1"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="#0F172A" />

                    <!-- Segment 2: RAM Diperluas / zRAM (Cyan) -->
                    <View
                        android:id="@+id/ram_bar_expanded"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="33"
                        android:background="#22D3EE" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/ram_bar_div2"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="#0F172A" />

                    <!-- Segment 3: Tersedia (Subtle Dark Slate) -->
                    <View
                        android:id="@+id/ram_bar_free"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="25"
                        android:background="#334155" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3 Stat Tiles: Physical RAM, Expanded RAM, Available RAM (Optimized for 391 dpi) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Physical RAM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/home_stat_box_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:src="@drawable/ram_dot_green"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/ram_expansion_physical_label"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ram_stat_physical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="8 GB"
                        android:textSize="15sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <!-- Expanded RAM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/home_stat_box_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:src="@drawable/storage_dot_cyan"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/ram_expansion_expanded_label"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ram_stat_expanded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="+4 GB"
                        android:textSize="15sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="#22D3EE" />
                </LinearLayout>

                <!-- Available RAM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/home_stat_box_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:src="@drawable/storage_dot_purple"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/ram_expansion_avail_label"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ram_stat_available"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="7.8 GB"
                        android:textSize="15sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Explanation text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/ram_expansion_desc"
                android:textSize="12.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/ram_expansion_title"
        android:textSize="13sp"
        android:fontFamily="@font/product_sans_bold"
        android:textColor="?android:attr/textColorSecondary"
        android:textAllCaps="true" />

    <!-- 2. Options Selection Card (5 tiers: Off, 2GB, 4GB, 8GB, 16GB) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="?android:attr/dividerHorizontal"
            android:showDividers="middle">

            <!-- Option 1: Off (0 GB) -->
            <LinearLayout
                android:id="@+id/ram_row_opt_0"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ram_expansion_off"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioButton
                    android:id="@+id/ram_radio_opt_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Option 2: +2 GB -->
            <LinearLayout
                android:id="@+id/ram_row_opt_2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ram_expansion_2gb"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioButton
                    android:id="@+id/ram_radio_opt_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Option 3: +4 GB (Default - Tengah) -->
            <LinearLayout
                android:id="@+id/ram_row_opt_4"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ram_expansion_4gb"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioButton
                    android:id="@+id/ram_radio_opt_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Option 4: +8 GB -->
            <LinearLayout
                android:id="@+id/ram_row_opt_8"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ram_expansion_8gb"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioButton
                    android:id="@+id/ram_radio_opt_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Option 5: +16 GB (Maksimal) -->
            <LinearLayout
                android:id="@+id/ram_row_opt_16"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ram_expansion_16gb"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioButton
                    android:id="@+id/ram_radio_opt_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
