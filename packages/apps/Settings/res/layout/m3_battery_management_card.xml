<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- Section Category Header: MANAJEMEN DAYA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/m3_battery_management_title"
        android:textColor="#56D08B"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08" />

    <!-- 2x2 Bento Grid Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: Penghemat Baterai & Kesehatan Baterai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Tile 1: Penghemat Baterai -->
            <LinearLayout
                android:id="@+id/m3_tile_battery_saver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_tile_bg"
                android:padding="16dp"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Top Row: Icon + Badge -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:id="@+id/m3_tile_saver_icon_box"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_sub_chip_bg">

                        <ImageView
                            android:id="@+id/m3_tile_saver_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_m3_battery_saver"
                            app:tint="#7EE2A7"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/m3_tile_saver_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_dark_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/m3_battery_saver_off"
                        android:textColor="#A3C6B1"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/m3_tile_saver_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/m3_battery_saver_title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/m3_tile_saver_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/m3_battery_saver_desc"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="1dp" />
            </LinearLayout>

            <!-- Tile 2: Kesehatan Baterai -->
            <LinearLayout
                android:id="@+id/m3_tile_battery_health"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_tile_bg"
                android:padding="16dp"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Top Row: Icon + Badge -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_sub_chip_bg">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_m3_health_pulse"
                            app:tint="#7EE2A7"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/m3_tile_health_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_badge_green_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="70% (Baik)"
                        android:textColor="#7EE2A7"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/m3_battery_health_title_card"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/m3_tile_health_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1354 siklus • Kapasitas terukur 4850 mAh"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="1dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Pengelola Baterai & Widget Baterai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Tile 3: Pengelola Baterai -->
            <LinearLayout
                android:id="@+id/m3_tile_battery_manager"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_tile_bg"
                android:padding="16dp"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Top Row: Icon + Badge -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_sub_chip_bg">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_m3_smart_battery"
                            app:tint="#56D0B0"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/m3_tile_manager_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_badge_green_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/m3_battery_manager_badge"
                        android:textColor="#7EE2A7"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/m3_battery_manager_title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/m3_tile_manager_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/m3_battery_manager_desc"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="1dp" />
            </LinearLayout>

            <!-- Tile 4: Widget Baterai -->
            <LinearLayout
                android:id="@+id/m3_tile_battery_widget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_tile_bg"
                android:padding="16dp"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Top Row: Icon + Badge -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_sub_chip_bg">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_m3_widget"
                            app:tint="#B4F0CE"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/m3_tile_widget_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/m3_battery_dark_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/m3_battery_widget_badge"
                        android:textColor="#B4F0CE"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/m3_battery_widget_title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/m3_tile_widget_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/m3_battery_widget_desc"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="1dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
