<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="16dp">

    <!-- Section Category Header: INFO & TAMPILAN BATERAI -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/m3_battery_display_info_title"
        android:textColor="#56D08B"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08" />

    <!-- Card Container (.m3-group in #161E19) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/m3_battery_card_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: Persentase baterai -->
        <RelativeLayout
            android:id="@+id/m3_row_battery_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/m3_icon_box_percent"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/m3_battery_sub_chip_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_m3_percent"
                    app:tint="#7EE2A7"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/m3_icon_box_percent"
                android:layout_toStartOf="@id/m3_switch_battery_percent"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_battery_percentage_title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/m3_battery_percentage_sub"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <Switch
                android:id="@+id/m3_switch_battery_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:showText="false"
                android:textOn=""
                android:textOff=""
                android:thumbTint="@color/m3_battery_switch_thumb_color"
                android:trackTint="@color/m3_battery_switch_track_color" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#223028"
            android:layout_marginVertical="8dp" />

        <!-- Row 2: Info Pengisian Daya di Layar Kunci -->
        <RelativeLayout
            android:id="@+id/m3_row_lockscreen_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/m3_icon_box_lockscreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_alignTop="@id/m3_text_lockscreen_container"
                android:background="@drawable/m3_battery_sub_chip_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_m3_speedometer"
                    app:tint="#56D0B0"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/m3_text_lockscreen_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/m3_icon_box_lockscreen"
                android:layout_toStartOf="@id/m3_switch_lockscreen_info"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_lockscreen_info_title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/m3_lockscreen_info_sub"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <!-- Telemetry Preview Chip: 1.420 mA • 3,90 V • 5,5 W • 38,9 °C -->
                <LinearLayout
                    android:id="@+id/m3_lockscreen_preview_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/m3_battery_dark_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/m3_lockscreen_preview_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.420 mA • 3,90 V • 5,5 W • 38,9 °C"
                        android:textColor="#7EE2A7"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <Switch
                android:id="@+id/m3_switch_lockscreen_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:showText="false"
                android:textOn=""
                android:textOff=""
                android:thumbTint="@color/m3_battery_switch_thumb_color"
                android:trackTint="@color/m3_battery_switch_track_color" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#223028"
            android:layout_marginVertical="8dp" />

        <!-- Row 3: Informasi baterai -->
        <RelativeLayout
            android:id="@+id/m3_row_battery_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/m3_icon_box_info"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/m3_battery_sub_chip_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_m3_battery_settings"
                    app:tint="#7EE2A7"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/m3_icon_box_info"
                android:layout_toStartOf="@id/m3_chevron_info"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_info"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/m3_text_info_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kesehatan baterai (70%), siklus pengisian (1354x), kapasitas (5000 mAh)"
                    android:textColor="#A3C6B1"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/m3_chevron_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="›"
                android:textColor="#A3C6B1"
                android:textSize="22sp"
                android:fontFamily="sans-serif-bold" />
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
