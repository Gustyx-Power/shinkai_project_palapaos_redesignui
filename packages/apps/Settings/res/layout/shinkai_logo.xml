<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:selectable="false"
    android:clickable="false">

    <!-- ======================================================== -->
    <!-- CHUNK 1: Modern Palapa OS Hero Card Banner                 -->
    <!-- ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/palapa_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/about_card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/palapa_banner_card_background"
            android:padding="20dp">

            <!-- Top Header: 3-Second Carousel (Palapa OS & Shinkai Project) -->
            <ViewFlipper
                android:id="@+id/palapa_header_flipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:flipInterval="3000"
                android:autoStart="true"
                android:inAnimation="@anim/shinkai_slide_in_bottom"
                android:outAnimation="@anim/shinkai_slide_out_top">

                <!-- Slide 1: Palapa OS + Kopdes Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/palapa_logo_box_bg"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:src="@drawable/kopdes"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null"
                            android:clickable="false" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/palapa_os_title"
                            android:textSize="26sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Slide 2: Shinkai Project + Shinkai Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/palapa_logo_box_bg"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shinkai_logo"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null"
                            android:clickable="false" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shinkai Project"
                            android:textSize="26sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

            </ViewFlipper>

            <!-- Subtle Modern Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/palapa_divider" />

            <!-- Bottom Quick Stats Row (3 Modern Mini-Cards) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Card 1: Android Version & Easter Egg Logo -->
                <LinearLayout
                    android:id="@+id/palapa_stat_android_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/palapa_stat_box_bg"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/palapa_stat_android_logo"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_android_17_platlogo"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/palapa_stat_os_label"
                        android:textSize="10sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:fontFamily="@font/product_sans_bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_stat_android_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="17"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:fontFamily="@font/product_sans_bold"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Card 3: Device -->
                <LinearLayout
                    android:id="@+id/palapa_stat_device_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/palapa_stat_box_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_settings_about_device_filled"
                        app:tint="?android:attr/textColorPrimary"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/palapa_stat_device_label"
                        android:textSize="10sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:fontFamily="@font/product_sans_bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_stat_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Marble"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:fontFamily="@font/product_sans_bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

            </LinearLayout>

            <!-- Modern Shinkai Project Credit Bar (Based By Shinkai Project) -->
            <LinearLayout
                android:id="@+id/palapa_shinkai_credit_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/palapa_shinkai_credit_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <!-- Shinkai Logo Container with Accent Circle Background -->
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/palapa_shinkai_icon_circle_bg"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shinkai_logo"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </FrameLayout>

                <!-- Based By Shinkai Project Label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/palapa_based_shinkai_project"
                    android:textSize="12sp"
                    android:fontFamily="@font/product_sans_bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:includeFontPadding="false" />

                <!-- Hashtag Badge: #ShinkaiProjectOnTop! -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/palapa_hashtag_badge_bg"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/palapa_shinkai_hashtag"
                    android:textSize="11sp"
                    android:fontFamily="@font/product_sans_bold"
                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ======================================================== -->
    <!-- CHUNK 2: Sistem & Keamanan (Core OS & Security Chunk)    -->
    <!-- ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/palapa_chunk_system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/about_card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Card Category Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="16dp"
                    android:layout_height="11dp"
                    android:background="@drawable/palapa_mini_indonesia_flag" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/palapa_chunk_system_title"
                    android:textSize="12sp"
                    android:fontFamily="@font/product_sans_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textColor="@color/shinkai_logo_accent"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 1. Versi Android -->
            <LinearLayout
                android:id="@+id/palapa_row_android_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_android_17_platlogo"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/firmware_version"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_android_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="17"
                        android:textSize="14sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/palapa_divider" />

            <!-- 2. Versi Shinkai -->
            <LinearLayout
                android:id="@+id/palapa_row_shinkai_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shinkai_logo"
                        app:tint="@color/shinkai_logo_accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shinkai_version"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_shinkai_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="heptakaideka-marble-20260921-2138"
                        android:textSize="14sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/palapa_divider" />

            <!-- 3. Versi Palapa OS -->
            <LinearLayout
                android:id="@+id/palapa_row_palapa_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/kopdes"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/palapa_os_version"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_palapa_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Trowulan"
                        android:textSize="14sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/palapa_divider" />

            <!-- 3. Update Keamanan Android -->
            <LinearLayout
                android:id="@+id/palapa_row_security_patch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_security"
                        app:tint="@color/shinkai_logo_accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_patch"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_security_patch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textSize="14sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/palapa_divider" />

            <!-- 4. Maintainer Source Row (Static: SkyyVerse & kylieeXD) -->
            <LinearLayout
                android:id="@+id/palapa_row_maintainer_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_palapa_maintainer_source"
                        android:tint="@color/shinkai_logo_accent"
                        app:tint="@color/shinkai_logo_accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shinkai_maintainer_source"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_maintainer_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="SkyyVerse &amp; kylieeXD"
                        android:textSize="14sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/palapa_divider" />

            <!-- 5. Maintainer Device Row (From Prop: Pavelc4) -->
            <LinearLayout
                android:id="@+id/palapa_row_maintainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_palapa_maintainer_device"
                        android:tint="@color/shinkai_logo_accent"
                        app:tint="@color/shinkai_logo_accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shinkai_maintainer"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_maintainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Pavelc4"
                        android:textSize="14sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ======================================================== -->
    <!-- CHUNK 4: Kernel & Perangkat Keras (Kernel & Radio Chunk) -->
    <!-- ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/palapa_chunk_hardware"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/about_card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Card Category Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="@string/palapa_chunk_hardware_title"
                android:textSize="12sp"
                android:fontFamily="@font/product_sans_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:textColor="@color/shinkai_logo_accent"
                android:includeFontPadding="false" />

            <!-- Versi Kernel -->
            <LinearLayout
                android:id="@+id/palapa_row_kernel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_cpu"
                        app:tint="@color/shinkai_logo_accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kernel_version"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_kernel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textSize="13.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/palapa_divider" />

            <!-- Versi Pita Basis (Baseband) -->
            <LinearLayout
                android:id="@+id/palapa_row_baseband"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/palapa_icon_box_bg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_cellular"
                        app:tint="@color/shinkai_logo_accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/baseband_version"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/palapa_val_baseband"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textSize="13.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ======================================================== -->
    <!-- CHUNK 5: Info Build Card                                 -->
    <!-- ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/palapa_chunk_build"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/about_card_bg">

        <LinearLayout
            android:id="@+id/palapa_row_build_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/palapa_icon_box_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings_development"
                    app:tint="@color/shinkai_logo_accent"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/build_number"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/palapa_val_build_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textSize="14sp"
                    android:fontFamily="@font/product_sans_bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
