<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Hero Battery Card (M3 Solid Monet Deep Green) -->
    <LinearLayout
        android:id="@+id/m3_hero_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/m3_battery_hero_bg"
        android:padding="20dp">

        <!-- Top Row: Badge Pill and Squircle Battery Icon Box -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Pill Badge: ⚡ Mengisi daya lambat • Adaptif -->
            <LinearLayout
                android:id="@+id/m3_hero_badge_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/m3_battery_pill_badge_bg"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/m3_hero_badge_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_m3_voltage"
                    app:tint="#7EE2A7"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/m3_hero_badge_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_battery_charging_slow_adaptive"
                    android:textColor="#B4F0CE"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Top Right Icon Box: Light Green Squircle -->
            <FrameLayout
                android:id="@+id/m3_hero_icon_box"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/m3_battery_hero_icon_bg">

                <ImageView
                    android:id="@+id/m3_hero_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_battery_charging_full"
                    app:tint="#044426"
                    android:contentDescription="@null" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Percentage & Time Left Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/m3_battery_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="56%"
                android:textColor="#7EE2A7"
                android:textSize="48sp"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/m3_battery_time_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/m3_battery_percent"
                android:layout_alignBaseline="@id/m3_battery_percent"
                android:layout_marginStart="8dp"
                android:text="• Penuh dlm ~1j 25m"
                android:textColor="#B4F0CE"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />
        </RelativeLayout>

        <!-- Thick Capsule Progress Bar (36dp) with Embedded Capacity (2.800 / 5.000 mAh) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="16dp">

            <ProgressBar
                android:id="@+id/m3_battery_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="56"
                android:progressDrawable="@drawable/m3_battery_progress_bar_drawable" />

            <TextView
                android:id="@+id/m3_hero_capacity_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="2.800 / 5.000 mAh"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:includeFontPadding="false" />
        </FrameLayout>

        <!-- 3 Telemetry Quick Chips Row: Suhu, Voltase, Kesehatan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Chip 1: Suhu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_sub_chip_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:layout_marginEnd="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_m3_thermometer"
                        app:tint="#7EE2A7"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/m3_battery_temp_title"
                        android:textColor="#A3C6B1"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/m3_hero_val_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="38,9 °C"
                    android:textColor="#7EE2A7"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <!-- Chip 2: Voltase -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_sub_chip_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:layout_marginHorizontal="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_m3_voltage"
                        app:tint="#7EE2A7"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/m3_battery_volt_title"
                        android:textColor="#A3C6B1"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/m3_hero_val_volt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="3,90 V"
                    android:textColor="#7EE2A7"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <!-- Chip 3: Kesehatan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/m3_battery_sub_chip_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:layout_marginStart="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_m3_heart"
                        app:tint="#7EE2A7"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/m3_battery_health_title"
                        android:textColor="#A3C6B1"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/m3_hero_val_health"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="70% Baik"
                    android:textColor="#7EE2A7"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Bar Row: Mengisi daya • 1354 siklus pengisian tercatat | Detail > -->
    <RelativeLayout
        android:id="@+id/m3_hero_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/m3_battery_bottom_bar_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/m3_battery_info_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_info_outline_24"
            app:tint="#7EE2A7"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/m3_battery_cycle_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/m3_battery_info_icon"
            android:layout_toStartOf="@id/m3_hero_btn_detail"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="Mengisi daya • 1354 siklus pengisian tercatat"
            android:textColor="#C8E6D4"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/m3_hero_btn_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/m3_battery_detail_btn"
            android:textColor="#7EE2A7"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold" />
    </RelativeLayout>

</LinearLayout>
