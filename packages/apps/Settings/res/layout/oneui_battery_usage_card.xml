<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/oneui_battery_card_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <!-- Header / Mode Selector Row -->
        <LinearLayout
            android:id="@+id/oneui_mode_selector_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/oneui_mode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/oneui_battery_daily_usage"
                android:textColor="@color/oneui_battery_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="▼"
                android:textColor="@color/oneui_battery_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Since Last Charge Subtitle (Visible only in Mode Since Last Charge) -->
        <LinearLayout
            android:id="@+id/oneui_since_last_charge_sub_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/oneui_last_charged_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/oneui_battery_last_charged_to"
                android:textColor="@color/oneui_battery_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/oneui_stopped_charging_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Stopped charging 1 h 54 m ago"
                android:textColor="@color/oneui_battery_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- One UI Battery Chart View -->
        <com.android.settings.fuelgauge.batteryusage.OneUIBatteryChartView
            android:id="@+id/oneui_battery_chart"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="16dp" />

        <!-- Subheader: Battery usage: 56% -->
        <TextView
            android:id="@+id/oneui_battery_usage_total_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:text="Battery usage: 56%"
            android:textColor="@color/oneui_battery_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Top App Usage List Container -->
        <LinearLayout
            android:id="@+id/oneui_top_apps_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App Row 1 -->
            <RelativeLayout
                android:id="@+id/oneui_app_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:visibility="gone"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/oneui_app_icon_1"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_settings_battery_filled" />

                <TextView
                    android:id="@+id/oneui_app_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/oneui_app_icon_1"
                    android:layout_toStartOf="@id/oneui_app_percent_1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/oneui_app_percent_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text=""
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </RelativeLayout>

            <!-- Divider 1 -->
            <View
                android:id="@+id/oneui_divider_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/oneui_battery_divider" />

            <!-- App Row 2 -->
            <RelativeLayout
                android:id="@+id/oneui_app_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:visibility="gone"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/oneui_app_icon_2"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_settings_battery_filled" />

                <TextView
                    android:id="@+id/oneui_app_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/oneui_app_icon_2"
                    android:layout_toStartOf="@id/oneui_app_percent_2"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/oneui_app_percent_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text=""
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </RelativeLayout>

            <!-- Divider 2 -->
            <View
                android:id="@+id/oneui_divider_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/oneui_battery_divider" />

            <!-- App Row 3 -->
            <RelativeLayout
                android:id="@+id/oneui_app_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:visibility="gone"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/oneui_app_icon_3"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_settings_battery_filled" />

                <TextView
                    android:id="@+id/oneui_app_name_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/oneui_app_icon_3"
                    android:layout_toStartOf="@id/oneui_app_percent_3"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/oneui_app_percent_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text=""
                    android:textColor="@color/oneui_battery_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Divider above View Details -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="@color/oneui_battery_divider" />

        <!-- View details Button -->
        <TextView
            android:id="@+id/oneui_btn_view_details"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/oneui_battery_view_details"
            android:textColor="@color/oneui_battery_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/oneui_battery_btn_bg"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</LinearLayout>
