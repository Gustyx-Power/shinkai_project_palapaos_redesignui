<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- Hero Card containing Side-by-Side Phone Previews and Dynamic Description -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cc_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <!-- Side-by-Side Device Previews -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Option 1: One UI (Terpisah) -->
                <LinearLayout
                    android:id="@+id/cc_option_oneui"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="230dp"
                        android:src="@drawable/ic_cc_preview_oneui"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/cc_text_oneui_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/control_center_style_oneui_title"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/control_center_style_oneui_name"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <RadioButton
                        android:id="@+id/cc_radio_oneui"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- Divider Gap -->
                <View
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <!-- Option 2: Pixel (Gabungkan) -->
                <LinearLayout
                    android:id="@+id/cc_option_pixel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="230dp"
                        android:src="@drawable/ic_cc_preview_pixel"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/cc_text_pixel_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/control_center_style_pixel_title"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/control_center_style_pixel_name"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <RadioButton
                        android:id="@+id/cc_radio_pixel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dynamic Description Text -->
            <TextView
                android:id="@+id/cc_desc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/control_center_desc_oneui"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Restart System UI Card (Appears dynamically when QS style is changed) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cc_restart_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/cc_restart_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_restart_systemui"
                    android:tint="?android:attr/colorAccent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/cc_restart_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/control_center_restart_title"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/cc_restart_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/control_center_restart_desc"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cc_restart_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/control_center_restart_btn"
                android:textSize="14sp"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_restart_systemui"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dynamic Island Charging (Experimental) Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cc_dynamic_island_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dynamic_island_title"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/dynamic_island_summary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/cc_dynamic_island_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
