<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipToPadding="false">

    <!-- Modern Solid Monet Storage Hero Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/storage_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:strokeColor="@android:color/transparent"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- 1. Top Row: Percentage Pill Badge (Left) + Available Cloud Info (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left: % Digunakan Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/storage_pill_badge_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/storage_dot_cyan"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/storage_badge_used_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/storage_badge_used_default"
                        android:textSize="11sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Right: Tersedia Cloud Info -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_storage_cloud"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/storage_text_available"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/storage_available_default"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Middle Row: Big Used Numbers (Left) + Health Status (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left: Big Number + Specs Subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/storage_big_used_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30"
                            android:textSize="44sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/storage_big_used_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp"
                            android:text="GB"
                            android:textSize="20sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/storage_text_total_spec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/storage_spec_default"
                        android:textSize="12sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Right: Health Status Badge & Subtitle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/storage_health_badge_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_storage_check_badge"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/storage_health_excellent"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="#2DD4BF"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/storage_status_optimal"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/product_sans_bold"
                        android:textColor="?android:attr/textColorSecondary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Multi-Segment Horizontal Storage Bar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:id="@+id/storage_segment_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <!-- Segment 1: Sistem (Cyan) -->
                    <View
                        android:id="@+id/storage_segment_system"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="24.2"
                        android:background="#22D3EE" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/storage_segment_div1"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="#0F172A" />

                    <!-- Segment 2: Aplikasi (Purple) -->
                    <View
                        android:id="@+id/storage_segment_apps"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="5.1"
                        android:background="#A855F7" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/storage_segment_div2"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="#0F172A" />

                    <!-- Segment 3: Lainnya (Orange / Amber) -->
                    <View
                        android:id="@+id/storage_segment_other"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.7"
                        android:background="#F59E0B" />

                    <!-- Segment 4: Free Space -->
                    <View
                        android:id="@+id/storage_segment_free"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="226"
                        android:background="@android:color/transparent" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Bottom Category Breakdown Pills (2x2 Grid) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1: Sistem & Aplikasi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Pill Sistem -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/storage_pill_badge_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/storage_dot_cyan"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/storage_pill_system_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/storage_pill_system_default"
                            android:textSize="12sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <!-- Pill Aplikasi -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/storage_pill_badge_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/storage_dot_purple"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/storage_pill_apps_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/storage_pill_apps_default"
                            android:textSize="12sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Lainnya & Kosong -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Pill Lainnya -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/storage_pill_badge_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/storage_dot_amber"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/storage_pill_other_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/storage_pill_other_default"
                            android:textSize="12sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <!-- Pill Kosong -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/storage_pill_badge_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/storage_dot_grey"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/storage_pill_free_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/storage_pill_free_default"
                            android:textSize="12sp"
                            android:fontFamily="@font/product_sans_bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Hidden stub views for framework compatibility with UsageProgressBarPreference -->
    <TextView
        android:id="@+id/usage_summary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/total_summary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@android:id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/custom_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bottom_summary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
