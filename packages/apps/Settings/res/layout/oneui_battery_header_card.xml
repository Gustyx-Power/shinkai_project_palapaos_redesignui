<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Top Row: 81% and 8 h 35 m left -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/oneui_battery_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="81%"
            android:textColor="@color/oneui_battery_text_primary"
            android:textSize="38sp"
            android:fontFamily="sans-serif-bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/oneui_battery_time_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignBaseline="@id/oneui_battery_percent"
            android:text="8 h 35 m left"
            android:textColor="@color/oneui_battery_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </RelativeLayout>

    <!-- Pill Progress Bar -->
    <ProgressBar
        android:id="@+id/oneui_battery_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="81"
        android:progressDrawable="@drawable/oneui_battery_progress_pill" />

    <!-- Bottom info row: Full charge duration + Info icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/oneui_battery_full_charge_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/oneui_battery_info_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:text="A full charge will last about 10 h 36 m"
            android:textColor="@color/oneui_battery_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <ImageView
            android:id="@+id/oneui_battery_info_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_info_outline_24"
            app:tint="@color/oneui_battery_text_secondary"
            android:contentDescription="@string/battery_info" />
    </RelativeLayout>

</LinearLayout>
