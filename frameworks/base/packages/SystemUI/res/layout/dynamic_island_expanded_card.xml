<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expanded_island_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <!-- Card Body (Smooth Rounded Floating Island - OriginOS Aesthetic) -->
    <FrameLayout
        android:id="@+id/expanded_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dynamic_island_expanded_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:clickable="true"
        android:focusable="true">

        <!-- 1. Screen Recording Expanded Controls (Simplified Authentic OriginOS Layout) -->
        <LinearLayout
            android:id="@+id/expanded_record_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Left: OriginOS Camera Badge -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dynamic_island_origin_record_badge">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_origin_rec_cam"
                    android:contentDescription="@null" />

                <!-- Pulsating red dot indicator in top-right of badge -->
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_dynamic_island_record_dot"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Middle: Title & Live Running Timer -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/expanded_record_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dynamic_island_record_label"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dynamic_island_record_elapsed"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="•"
                        android:textColor="#FF453A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/expanded_record_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="00:00"
                        android:textColor="#FF453A"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: Authentic OriginOS Stop Button (White Outer Ring + Red Square Center) -->
            <FrameLayout
                android:id="@+id/expanded_record_stop_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/dynamic_island_origin_stop_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/dynamic_island_record_stop">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_origin_stop"
                    android:contentDescription="@null" />
            </FrameLayout>

        </LinearLayout>

        <!-- 2. Flashlight Expanded Controls (Modern Origin Aesthetic) -->
        <LinearLayout
            android:id="@+id/expanded_torch_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Glowing Flashlight Toggle Button (Left) -->
            <FrameLayout
                android:id="@+id/expanded_torch_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dynamic_island_btn_amber_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/dynamic_island_torch_label">

                <ImageView
                    android:id="@+id/expanded_torch_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_origin_torch"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Flashlight Status (Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end|center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dynamic_island_torch_label"
                    android:textColor="#FFD60A"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/expanded_torch_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dynamic_island_torch_on"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/dynamic_island_torch_subtext"
                    android:textColor="#8E8E93"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>

        <!-- 3. Charging Expanded Info (Modern Origin Aesthetic) -->
        <LinearLayout
            android:id="@+id/expanded_charging_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Green Bolt Badge (Left) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dynamic_island_btn_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dynamic_island_bolt"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Charging Percentage & Status (Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end|center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dynamic_island_charging"
                    android:textColor="#30D158"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/expanded_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="100%"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
