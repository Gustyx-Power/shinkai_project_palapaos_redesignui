<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expanded_island_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <!-- Card Body (Smooth Rounded Floating Island - OriginOS Aesthetic) -->
    <FrameLayout
        android:id="@+id/expanded_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dynamic_island_expanded_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:clickable="true"
        android:focusable="true">

        <!-- 1. Screen Recording Expanded Controls (OriginOS Layout) -->
        <LinearLayout
            android:id="@+id/expanded_record_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Top Header: [Red Badge: Camera + 00:00] [Perekam Layar] .............. [Stop Ring] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Red Badge: Camera Icon + Elapsed Timer -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/dynamic_island_origin_record_badge"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_origin_rec_cam"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/expanded_record_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- Title Label: Merekam layar / Screen Recording -->
                <TextView
                    android:id="@+id/expanded_record_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/dynamic_island_record_label"
                    android:textColor="#F2F2F2"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Stop Button (White Outer Ring Border with Red Square Center) -->
                <FrameLayout
                    android:id="@+id/expanded_record_stop_btn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/dynamic_island_origin_stop_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/dynamic_island_record_stop">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_origin_stop"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <!-- Subtle Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="#20FFFFFF" />

            <!-- Recording Settings Section (Android Native Controls) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Rekam audio perangkat -->
                <LinearLayout
                    android:id="@+id/expanded_record_row_device_audio"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_origin_sound_wave"
                        android:tint="#CCCCCC"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dynamic_island_record_device_audio"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <Switch
                        android:id="@+id/expanded_record_switch_device_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/ScreenRecord.Switch" />
                </LinearLayout>

                <!-- 2. Rekam mikrofon -->
                <LinearLayout
                    android:id="@+id/expanded_record_row_mic"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_origin_mic"
                        android:tint="#CCCCCC"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dynamic_island_record_mic"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <Switch
                        android:id="@+id/expanded_record_switch_mic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/ScreenRecord.Switch" />
                </LinearLayout>

                <!-- 3. Tampilkan sentuhan -->
                <LinearLayout
                    android:id="@+id/expanded_record_row_touches"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_touch"
                        android:tint="#CCCCCC"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dynamic_island_record_show_touches"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <Switch
                        android:id="@+id/expanded_record_switch_touches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/ScreenRecord.Switch" />
                </LinearLayout>

                <!-- 4. Kualitas lebih rendah (SD) -->
                <LinearLayout
                    android:id="@+id/expanded_record_row_low_quality"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_sr_quality"
                        android:tint="#CCCCCC"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dynamic_island_record_low_quality"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <Switch
                        android:id="@+id/expanded_record_switch_low_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/ScreenRecord.Switch" />
                </LinearLayout>

                <!-- 5. Batas ukuran file lebih besar -->
                <LinearLayout
                    android:id="@+id/expanded_record_row_longer_duration"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_storage"
                        android:tint="#CCCCCC"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dynamic_island_record_longer_duration"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <Switch
                        android:id="@+id/expanded_record_switch_longer_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/ScreenRecord.Switch" />
                </LinearLayout>

                <!-- 6. Encoding HEVC -->
                <LinearLayout
                    android:id="@+id/expanded_record_row_hevc"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_hevc"
                        android:tint="#CCCCCC"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dynamic_island_record_hevc"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <Switch
                        android:id="@+id/expanded_record_switch_hevc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/ScreenRecord.Switch" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 2. Flashlight Expanded Controls (Modern Origin Aesthetic) -->
        <LinearLayout
            android:id="@+id/expanded_torch_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Glowing Flashlight Toggle Button (Left) -->
            <FrameLayout
                android:id="@+id/expanded_torch_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dynamic_island_btn_amber_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/dynamic_island_torch_label">

                <ImageView
                    android:id="@+id/expanded_torch_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_origin_torch"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Flashlight Status (Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end|center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dynamic_island_torch_label"
                    android:textColor="#FFD60A"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/expanded_torch_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dynamic_island_torch_on"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/dynamic_island_torch_subtext"
                    android:textColor="#8E8E93"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>

        <!-- 3. Charging Expanded Info (Modern Origin Aesthetic) -->
        <LinearLayout
            android:id="@+id/expanded_charging_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Green Bolt Badge (Left) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dynamic_island_btn_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dynamic_island_bolt"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Charging Percentage & Status (Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end|center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dynamic_island_charging"
                    android:textColor="#30D158"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/expanded_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="100%"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
