<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/island_capsule"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/dynamic_island_pill_bg"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <!-- Left: Charging Status Text -->
        <TextView
            android:id="@+id/island_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dynamic_island_charging"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <!-- Spacer / Gap -->
        <View
            android:id="@+id/island_spacer"
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <!-- Right: Battery Percentage Text -->
        <TextView
            android:id="@+id/island_battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:singleLine="true" />

        <!-- Right: Green Lightning Bolt -->
        <ImageView
            android:id="@+id/island_bolt_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_dynamic_island_bolt"
            android:contentDescription="@null" />

    </LinearLayout>

</merge>
