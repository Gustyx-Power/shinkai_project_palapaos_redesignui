<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/island_root_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Meta-Ball (Secondary Bubble on Left Side) -->
        <FrameLayout
            android:id="@+id/island_meta_ball"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dynamic_island_circle_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/island_meta_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />

            <!-- Red Dot for record when in meta ball -->
            <ImageView
                android:id="@+id/island_meta_record_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dynamic_island_record_dot"
                android:visibility="gone"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Main Dynamic Island Capsule (Punch-Hole Aligned) -->
        <FrameLayout
            android:id="@+id/island_capsule"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:background="@drawable/dynamic_island_pill_bg"
            android:clickable="true"
            android:focusable="true">

            <!-- 1. Charging Content -->
            <LinearLayout
                android:id="@+id/island_charging_content"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/island_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dynamic_island_charging"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />

                <View
                    android:id="@+id/island_spacer"
                    android:layout_width="36dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/island_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/island_bolt_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_dynamic_island_bolt"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- 2. Flashlight Content (Main Pill - Symmetrical Wings around Punch-Hole) -->
            <LinearLayout
                android:id="@+id/island_torch_content"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minWidth="142dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp">

                    <ImageView
                        android:id="@+id/island_torch_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_origin_torch"
                        android:contentDescription="@null" />
                </FrameLayout>

                <View
                    android:id="@+id/island_torch_spacer"
                    android:layout_width="38dp"
                    android:layout_height="1dp" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp">

                    <TextView
                        android:id="@+id/island_torch_action_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/dynamic_island_torch_on"
                        android:textColor="#FFD60A"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        android:singleLine="true" />
                </FrameLayout>
            </LinearLayout>

            <!-- 3. Screen Recording Content (Main Pill - Symmetrical Wings around Punch-Hole) -->
            <LinearLayout
                android:id="@+id/island_record_content"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minWidth="142dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp">

                    <ImageView
                        android:id="@+id/island_record_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_dynamic_island_record_dot"
                        android:contentDescription="@null" />
                </FrameLayout>

                <View
                    android:id="@+id/island_record_spacer"
                    android:layout_width="38dp"
                    android:layout_height="1dp" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp">

                    <TextView
                        android:id="@+id/island_record_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="00:00"
                        android:textColor="#FF453A"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-bold"
                        android:singleLine="true" />
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</merge>
