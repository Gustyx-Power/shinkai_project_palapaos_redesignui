diff --git a/res/layout/about_phone_dashboard.xml b/res/layout/about_phone_dashboard.xml
new file mode 100644
index 0000000..7cbaa4b
--- /dev/null
+++ b/res/layout/about_phone_dashboard.xml
@@ -0,0 +1,674 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 Wowo OS / Shinkai Project
+
+  Licensed under the Apache License, Version 2.0 (the "License");
+  you may not use this file except in compliance with the License.
+  You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+  Unless required by applicable law or agreed to in writing, software
+  distributed under the License is distributed on an "AS IS" BASIS,
+  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+  See the License for the specific language governing permissions and
+  limitations under the License.
+  -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:paddingStart="16dp"
+    android:paddingEnd="16dp"
+    android:paddingTop="4dp"
+    android:paddingBottom="20dp"
+    android:clipToPadding="false"
+    android:selectable="false"
+    android:clickable="false">
+
+    <!-- 1. Top Hero Banner Card (OriginOS 6 / iQOO style) -->
+    <com.google.android.material.card.MaterialCardView
+        android:id="@+id/about_iqoo_banner_card"
+        android:layout_width="match_parent"
+        android:layout_height="165dp"
+        app:cardCornerRadius="24dp"
+        app:cardElevation="0dp"
+        app:strokeWidth="0dp"
+        app:cardBackgroundColor="@android:color/transparent"
+        android:clickable="true"
+        android:focusable="true"
+        android:foreground="?android:attr/selectableItemBackground">
+
+        <FrameLayout
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:background="@drawable/iqoo_banner_art_bg">
+
+            <!-- Subtle Gradient Scrim Overlay -->
+            <View
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:layout_margin="3.5dp"
+                android:background="@drawable/about_banner_scrim" />
+
+            <!-- Centered OriginOS / Wowo OS Branding -->
+            <LinearLayout
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_gravity="center"
+                android:orientation="horizontal"
+                android:gravity="center_vertical">
+
+                <ImageView
+                    android:id="@+id/about_iqoo_banner_logo"
+                    android:layout_width="48dp"
+                    android:layout_height="48dp"
+                    android:src="@drawable/kopdes"
+                    android:scaleType="fitCenter"
+                    android:contentDescription="@null" />
+
+                <LinearLayout
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginStart="12dp"
+                    android:orientation="vertical">
+
+                    <TextView
+                        android:id="@+id/about_iqoo_banner_os_title"
+                        android:layout_width="wrap_content"
+                        android:layout_height="wrap_content"
+                        android:text="Wowo OS 19jt"
+                        android:textSize="26sp"
+                        android:fontFamily="@font/product_sans_bold"
+                        android:textStyle="bold"
+                        android:textColor="#FFFFFF"
+                        android:includeFontPadding="false" />
+
+                    <TextView
+                        android:id="@+id/about_iqoo_banner_os_subtitle"
+                        android:layout_width="wrap_content"
+                        android:layout_height="wrap_content"
+                        android:layout_marginTop="3dp"
+                        android:text="Kopdes Edition • Shinkai Project"
+                        android:textSize="12sp"
+                        android:textColor="#CCFFFFFF"
+                        android:fontFamily="sans-serif"
+                        android:includeFontPadding="false" />
+                </LinearLayout>
+
+            </LinearLayout>
+
+        </FrameLayout>
+
+    </com.google.android.material.card.MaterialCardView>
+
+    <!-- 2. Device Marketing Name Title (iQOO Z9x 5G style -> POCO F5) -->
+    <TextView
+        android:id="@+id/about_iqoo_marketing_name"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="20dp"
+        android:layout_marginBottom="16dp"
+        android:text="POCO F5"
+        android:textSize="26sp"
+        android:fontFamily="@font/product_sans_bold"
+        android:textStyle="bold"
+        android:textColor="?android:attr/textColorPrimary"
+        android:includeFontPadding="false" />
+
+    <!-- 3. Specifications Block with Accent Bars (▎) -->
+    <!-- Spec 1: Nama perangkat > -->
+    <LinearLayout
+        android:id="@+id/about_spec_device_name_container"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:clickable="true"
+        android:focusable="true"
+        android:background="?android:attr/selectableItemBackground"
+        android:paddingTop="4dp"
+        android:paddingBottom="10dp">
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center_vertical">
+
+            <View
+                android:layout_width="3dp"
+                android:layout_height="12dp"
+                android:layout_marginEnd="8dp"
+                android:background="@drawable/iqoo_spec_accent_bar" />
+
+            <TextView
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:text="@string/iqoo_spec_device_name_label"
+                android:textSize="12sp"
+                android:textColor="?android:attr/textColorSecondary"
+                android:includeFontPadding="false" />
+
+            <ImageView
+                android:id="@+id/about_spec_device_name_edit_btn"
+                android:layout_width="16dp"
+                android:layout_height="16dp"
+                android:layout_marginEnd="4dp"
+                android:src="@drawable/ic_mode_edit"
+                app:tint="?android:attr/textColorSecondary"
+                android:contentDescription="@string/edit" />
+
+            <ImageView
+                android:layout_width="14dp"
+                android:layout_height="14dp"
+                android:src="@drawable/ic_chevron_right_24dp"
+                app:tint="?android:attr/textColorSecondary"
+                android:contentDescription="@null" />
+        </LinearLayout>
+
+        <TextView
+            android:id="@+id/about_spec_device_name_value"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="11dp"
+            android:layout_marginTop="4dp"
+            android:text="Gustyx POCO F5"
+            android:textSize="14.5sp"
+            android:fontFamily="@font/product_sans_bold"
+            android:textStyle="bold"
+            android:textColor="?android:attr/textColorPrimary"
+            android:includeFontPadding="false" />
+    </LinearLayout>
+
+    <!-- Spec 2: Prosesor -->
+    <LinearLayout
+        android:id="@+id/about_spec_processor_container"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:clickable="true"
+        android:focusable="true"
+        android:background="?android:attr/selectableItemBackground"
+        android:layout_marginTop="4dp"
+        android:paddingBottom="10dp">
+
+        <LinearLayout
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center_vertical">
+
+            <View
+                android:layout_width="3dp"
+                android:layout_height="12dp"
+                android:layout_marginEnd="8dp"
+                android:background="@drawable/iqoo_spec_accent_bar" />
+
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="@string/iqoo_spec_processor_label"
+                android:textSize="12sp"
+                android:textColor="?android:attr/textColorSecondary"
+                android:includeFontPadding="false" />
+        </LinearLayout>
+
+        <TextView
+            android:id="@+id/about_spec_processor_value"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="11dp"
+            android:layout_marginTop="4dp"
+            android:text="2.91 GHz Qualcomm® Snapdragon® 7+ Gen 2 Mobile Platform Octa-core"
+            android:textSize="14.5sp"
+            android:fontFamily="@font/product_sans_bold"
+            android:textStyle="bold"
+            android:textColor="?android:attr/textColorPrimary"
+            android:includeFontPadding="false" />
+    </LinearLayout>
+
+    <!-- Spec 3 & 4: Penyimpanan telepon & RAM (Two columns) -->
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:layout_marginTop="4dp"
+        android:paddingBottom="10dp">
+
+        <!-- Column 1: Penyimpanan telepon -->
+        <LinearLayout
+            android:id="@+id/about_spec_storage_container"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:clickable="true"
+            android:focusable="true"
+            android:background="?android:attr/selectableItemBackground"
+            android:orientation="vertical"
+            android:paddingEnd="8dp">
+
+            <LinearLayout
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:orientation="horizontal"
+                android:gravity="center_vertical">
+
+                <View
+                    android:layout_width="3dp"
+                    android:layout_height="12dp"
+                    android:layout_marginEnd="8dp"
+                    android:background="@drawable/iqoo_spec_accent_bar" />
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="@string/iqoo_spec_storage_label"
+                    android:textSize="12sp"
+                    android:textColor="?android:attr/textColorSecondary"
+                    android:includeFontPadding="false" />
+            </LinearLayout>
+
+            <TextView
+                android:id="@+id/about_spec_storage_value"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginStart="11dp"
+                android:layout_marginTop="4dp"
+                android:text="256 GB"
+                android:textSize="14.5sp"
+                android:fontFamily="@font/product_sans_bold"
+                android:textStyle="bold"
+                android:textColor="?android:attr/textColorPrimary"
+                android:includeFontPadding="false" />
+        </LinearLayout>
+
+        <!-- Column 2: RAM -->
+        <LinearLayout
+            android:id="@+id/about_spec_ram_container"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:clickable="true"
+            android:focusable="true"
+            android:background="?android:attr/selectableItemBackground"
+            android:orientation="vertical"
