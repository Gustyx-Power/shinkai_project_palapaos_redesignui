+        android:bottom="1.5dp"
+        android:left="1.5dp"
+        android:right="1.5dp">
+        <shape android:shape="rectangle">
+            <solid android:color="@color/wowo_banner_bg" />
+            <corners android:radius="24.5dp" />
+        </shape>
+    </item>
+</layer-list>
