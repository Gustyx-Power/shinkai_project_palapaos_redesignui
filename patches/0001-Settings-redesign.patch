+package com.android.settings.system
+
+import android.content.Context
+import android.os.SystemProperties
+import androidx.preference.Preference
+import com.android.settings.R
+import com.android.settings.core.BasePreferenceController
+
+class RamExpansionPreferenceController(context: Context, key: String) :
+    BasePreferenceController(context, key) {
+
+    override fun getAvailabilityStatus(): Int = AVAILABLE
+
+    override fun getSummary(): CharSequence {
+        val expansionVal = SystemProperties.getInt("persist.vendor.ram_expansion", SystemProperties.getInt("persist.sys.ram_expansion", 4))
+        return if (expansionVal <= 0) {
+            mContext.getString(R.string.ram_expansion_status_off)
+        } else {
+            mContext.getString(R.string.ram_expansion_status_active, expansionVal)
+        }
+    }
+
+    override fun updateState(preference: Preference?) {
+        super.updateState(preference)
+        preference?.summary = summary
+    }
+}
